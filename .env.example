# ---- Production domain ----
DOMAIN=resume.example.com

# ---- Frontend runtime ----
VITE_API_BASE_URL=/api

# ---- Database ----
MYSQL_ROOT_PASSWORD=replace_with_a_long_root_password
DB_DATABASE=resume_studio
DB_USERNAME=resume_studio
DB_PASSWORD=replace_with_a_long_database_password

# ---- Redis ----
REDIS_PASSWORD=replace_with_a_long_redis_password

# ---- Initial administrator ----
# Created only when the account does not exist. Use at least 12 characters.
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=replace_with_a_strong_admin_password

# Local HTTP demo must use false. Set true when the public domain is served over HTTPS.
SESSION_COOKIE_SECURE=false



# ---- Image storage ----
# local = save to the server volume; oss = Alibaba Cloud OSS
STORAGE_TYPE=local
STORAGE_LOCAL_ROOT=./data/uploads

# Used only when STORAGE_TYPE=oss
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# Public image base URL, for example:
# https://your-bucket.oss-cn-shanghai.aliyuncs.com
# or your CDN domain, for example: https://img.yourname.com
OSS_PUBLIC_BASE_URL=
